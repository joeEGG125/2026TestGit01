<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>${assembly-func}</id>
    <formats>
        <format>${assembly-format-tar-gz}</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${assembly-fep-app}/${assembly-func}</baseDirectory>
    <dependencySets>
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <outputDirectory>${assembly-lib}</outputDirectory>
            <unpack>false</unpack>
            <includes>
                <include>commons-io:commons-io</include>
                <include>org.apache.commons:commons-lang3</include>
                <include>org.jasypt:jasypt</include>
                <include>org.springframework:spring-core</include>
                <include>org.springframework:spring-context</include>
                <include>org.springframework:spring-beans</include>
                <include>org.owasp.esapi:esapi</include>
                <include>com.ibm.db2:jcc</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <outputDirectory>${assembly-lib}</outputDirectory>
            <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
            <unpack>false</unpack>
            <includes>
                <include>com.syscom.feptcb:fep-frmcommon</include>
            </includes>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>../${project-name-config}/src/main/resources/</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>fep-jasypt-tool.properties</include>
            </includes>
            <fileMode>${assembly-file-mode}</fileMode>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>../${project-name-config}/src/main/resources/</directory>
            <outputDirectory>${assembly-lib}</outputDirectory>
            <includes>
                <include>ESAPI.properties</include>
                <include>validation.properties</include>
            </includes>
            <fileMode>${assembly-file-mode}</fileMode>
        </fileSet>
        <fileSet>
            <directory>${assembly-config-path}/${project.artifactId}/${assembly-func}/</directory>
            <outputDirectory>${assembly-lib}</outputDirectory>
            <includes>
                <include>slf4j-api-2.0.17.jar</include>
                <include>slf4j-nop-2.0.17.jar</include>
            </includes>
            <fileMode>${assembly-file-mode}</fileMode>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${assembly-config-path}/${project.artifactId}/${assembly-func}/run.bat</source>
            <outputDirectory>.</outputDirectory>
            <destName>run-${assembly-func}.bat</destName>
            <fileMode>${assembly-file-mode}</fileMode>
            <filtered>true</filtered>
        </file>
        <file>
            <source>${assembly-config-path}/${project.artifactId}/${assembly-func}/run.sh</source>
            <outputDirectory>.</outputDirectory>
            <destName>run_${assembly-shell}.sh</destName>
            <fileMode>${assembly-file-mode}</fileMode>
            <lineEnding>${assembly-lineEnding}</lineEnding>
            <filtered>true</filtered>
        </file>
        <file>
            <source>target/${project.artifactId}-${assembly-func}.jar</source>
            <outputDirectory>${assembly-lib}</outputDirectory>
            <destName>${assembly-func}.jar</destName>
        </file>
        <file>
            <source>${assembly-release-note-path}/${assembly-func}.txt</source>
            <outputDirectory>.</outputDirectory>
            <destName>${assembly-file-readme}</destName>
            <fileMode>${assembly-file-mode}</fileMode>
            <lineEnding>${assembly-lineEnding}</lineEnding>
        </file>
    </files>
</assembly>