<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syscom.fep.mybatis.ext.mapper.NotifytemplateExtMapper">
	<select id="getNotifyTemplatesById" parameterType="java.lang.String" resultMap="com.syscom.fep.mybatis.mapper.NotifytemplateMapper.BaseResultMap">
		SELECT
		<include refid="com.syscom.fep.mybatis.mapper.NotifytemplateMapper.Base_Column_List" />
		FROM NOTIFYTEMPLATE
		WHERE TEMPLATE_ID LIKE CONCAT(#{templateId}, '%')
	</select>
</mapper>