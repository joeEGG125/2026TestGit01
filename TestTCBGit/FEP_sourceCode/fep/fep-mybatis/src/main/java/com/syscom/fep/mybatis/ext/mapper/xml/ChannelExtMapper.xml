<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syscom.fep.mybatis.ext.mapper.ChannelExtMapper">
  <!-- add by wj 20210514-->
  <select id="selectByChannelName" parameterType="map" resultMap="com.syscom.fep.mybatis.mapper.ChannelMapper.BaseResultMap">
    SELECT 
    <include refid="com.syscom.fep.mybatis.mapper.ChannelMapper.Base_Column_List" />
    FROM CHANNEL
<!--    WHERE CHANNEL_NAME = #{channelName,jdbcType=VARCHAR}-->
    <if test="channelName == 'HCA'">
      WHERE CHANNEL_NAME IN ('HCE','HCA')
    </if>
    <if test="channelName != 'HCA'">
      WHERE CHANNEL_NAME = #{channelName,jdbcType=VARCHAR}
    </if>
    AND CHANNEL_CONTROL = 1
  </select>
  
  <select id="queryChannelOptions" resultMap="com.syscom.fep.mybatis.mapper.ChannelMapper.BaseResultMap">
  	SELECT 
  	<include refid="com.syscom.fep.mybatis.mapper.ChannelMapper.Base_Column_List" />
  	  FROM CHANNEL
  </select>

  <select id="queryChannelByControl" resultMap="com.syscom.fep.mybatis.mapper.ChannelMapper.BaseResultMap">
    SELECT
    <include refid="com.syscom.fep.mybatis.mapper.ChannelMapper.Base_Column_List" />
    FROM CHANNEL
    WHERE CHANNEL_CONTROL=1 ORDER BY CHANNEL_NAME ASC
  </select>
  
 <select id="queryChannelByCE" resultMap="com.syscom.fep.mybatis.mapper.ChannelMapper.BaseResultMap">
    SELECT
    <include refid="com.syscom.fep.mybatis.mapper.ChannelMapper.Base_Column_List" />
    FROM CHANNEL
  </select>
</mapper>