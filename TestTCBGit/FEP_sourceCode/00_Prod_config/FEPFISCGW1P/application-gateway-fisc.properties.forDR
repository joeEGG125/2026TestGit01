server.port=8301

spring.fep.application.name=fep-gateway

management.endpoints.prometheus.enabled=true
management.endpoints.web.exposure.include=*
management.metrics.tags.application=${spring.fep.application.name}-fisc
management.endpoint.health.show-details=always

#FISCGatewayManager
spring.register.bean[0]=com.syscom.fep.gateway.netty.fisc.FISCGatewayManager
#KeepAlive
#spring.register.bean[1]=com.syscom.fep.gateway.netty.fisc.keepalive.FISCGatewayKeepAliveServerConfiguration
#spring.register.bean[2]=com.syscom.fep.gateway.netty.fisc.keepalive.FISCGatewayKeepAliveClientConfiguration
#spring.register.bean[3]=com.syscom.fep.gateway.netty.fisc.keepalive.FISCGatewayKeepAliveRestfulClient

#restful controller for FISC Gateway
spring.register.controller[0]=com.syscom.fep.gateway.netty.fisc.ctrl.FISCGatewayClientRestfulCtrl
#restful controller for Receive and Ack KeepAlive
#spring.register.controller[1]=com.syscom.fep.gateway.netty.fisc.keepalive.FISCGatewayKeepAliveRestfulServer

#======================================== For Common ========================================
spring.fep.gateway.transmission.fisc.responseQueueExpiration=60000
#spring.fep.gateway.transmission.fisc.httpOperate=http://172.29.14.2:8301/recv/fisc/operate
#======================================== For Common ========================================

#======================================== TO FEPT FISC Service(socket) ========================================
spring.fep.gateway.transmission.fisc.tofepap[0].hostName=fepap1P
spring.fep.gateway.transmission.fisc.tofepap[0].host=10.0.54.33
spring.fep.gateway.transmission.fisc.tofepap[0].port=8733
spring.fep.gateway.transmission.fisc.tofepap[1].hostName=fepap1P
spring.fep.gateway.transmission.fisc.tofepap[1].host=10.0.54.33
spring.fep.gateway.transmission.fisc.tofepap[1].port=8733
spring.fep.gateway.transmission.fisc.tofepapMode=DYNAMIC
spring.fep.gateway.transmission.fisc.tofepapRetryInterval=3
spring.fep.gateway.transmission.fisc.tofepapRetryCount=10
spring.fep.gateway.transmission.fisc.tofepapResetToFepApModeTimer=300
#======================================== TO FEP FISC Service ========================================

#======================================== Primary ========================================
#FISC Gateway Sender -1
spring.fep.gateway.transmission.fisc.primary.sender[0].host=172.25.164.164
spring.fep.gateway.transmission.fisc.primary.sender[0].port=5003
spring.fep.gateway.transmission.fisc.primary.sender[0].reestablishConnectionInterval=1000
spring.fep.gateway.transmission.fisc.primary.sender[0].encoding=ebcdic
spring.fep.gateway.transmission.fisc.primary.sender[0].clientId=B006A02I
spring.fep.gateway.transmission.fisc.primary.sender[0].checkCode=10072004
spring.fep.gateway.transmission.fisc.primary.sender[0].tcpKeepIdle=120
spring.fep.gateway.transmission.fisc.primary.sender[0].tcpKeepInterval=10

#FISC Gateway Receiver-1
spring.fep.gateway.transmission.fisc.primary.receiver[0].host=172.25.164.164
spring.fep.gateway.transmission.fisc.primary.receiver[0].port=5004
spring.fep.gateway.transmission.fisc.primary.receiver[0].reestablishConnectionInterval=1000
spring.fep.gateway.transmission.fisc.primary.receiver[0].disConnectInterval=121000
spring.fep.gateway.transmission.fisc.primary.receiver[0].encoding=ebcdic
spring.fep.gateway.transmission.fisc.primary.receiver[0].clientId=B006A02O
spring.fep.gateway.transmission.fisc.primary.receiver[0].checkCode=10072004
spring.fep.gateway.transmission.fisc.primary.receiver[0].tcpKeepIdle=120
spring.fep.gateway.transmission.fisc.primary.receiver[0].tcpKeepInterval=10
spring.fep.gateway.transmission.fisc.primary.receiver[0].bisThreadNum=100
spring.fep.gateway.transmission.fisc.primary.receiver[0].asyncExecutorThreadNum=100
spring.fep.gateway.transmission.fisc.primary.receiver[0].eventLoopThreads=100

#FISC Gateway Server-1
spring.fep.gateway.transmission.fisc.primary.fepap[0].host=${spring.fep.hostip}
