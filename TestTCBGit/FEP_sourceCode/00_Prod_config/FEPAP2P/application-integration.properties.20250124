#base
spring.fep.systemid=FEP
spring.fep.hostip=10.0.54.34
spring.fep.hostname=fepap2P

#embedded server
spring.fep.embedded.server.baseDir=/fep/tmp/${management.metrics.tags.application}/basedir/
spring.fep.embedded.server.docRoot=/fep/tmp/${management.metrics.tags.application}/docroot/

#log
logging.config=classpath:logback-spring.xml
spring.fep.log.path=/fep/logs
spring.fep.log.jdbc.sqltiming.level=DEBUG
spring.fep.log.mybatis.level=DEBUG

#suipClient
spring.fep.suipclient.enable=true
spring.fep.suipclient.atmagent.enable=false

#t24
spring.fep.t24.method.comparetota.enable=false

#IMS
spring.fep.ims.tx.clientid=IFEPPB{0},1,10
spring.fep.ims.pbo.clientid=IFEPPD{0},1,10
spring.fep.ims.changekey.clientid=IFEPPF{0},1,2

#restful
spring.fep.restful.timeout=30000

#mail
spring.fep.mail.smtp=172.29.0.82
spring.fep.mail.port=25
spring.fep.mail.account=fep
spring.fep.mail.sscode=ENC(3SM3px7gSO1uXkn8maceH+ruzkzWt6iFEeeSLiKub7Bk5iDBvspd8+6nqRWITw8DSXogtkPmgdA36hY6y/XCIg==)

#BATCH
spring.fep.batch.base.host[0].name=fepap1P
spring.fep.batch.base.host[0].ip=10.0.54.33
spring.fep.batch.base.host[0].url=http://${spring.fep.batch.base.host[0].ip}:8084
spring.fep.batch.base.host[1].name=fepap2P
spring.fep.batch.base.host[1].ip=10.0.54.34
spring.fep.batch.base.host[1].url=http://${spring.fep.batch.base.host[1].ip}:8084
spring.fep.batch.base.task.path=/fep/fep-app/fep-batch-task
spring.fep.batch.base.task.jarNameTemplate=fep-batch-task-%s.jar

#server url
spring.fep.server.url.atm=http://${spring.fep.hostip}:8731/recv/atm
spring.fep.server.url.fisc=http://${spring.fep.hostip}:8733/recv/fisc


#server protocl
#restful, when FEP Server recv message from Gateway via restful
#socket, when FEP Server recv message from Gateway via socket
spring.fep.server.protocol.atm=socket
spring.fep.server.protocol.fisc=socket


#ATM
spring.fep.server.netty.atm.host=${spring.fep.hostip}
spring.fep.server.netty.atm.port=8731
spring.fep.server.netty.atm.reestablishConnectionInterval=5000
spring.fep.server.netty.atm.acceptIp=
spring.fep.server.netty.atm.serverBisThreadNum=300
spring.fep.server.netty.atm.clientBisThreadNum=300
spring.fep.server.netty.atm.rcvBufAllocator=16384
spring.fep.server.netty.atm.soRcvBuf=16384
spring.fep.server.netty.atm.soSndBuf=16384
spring.fep.server.netty.atm.useDynamicEventExecutorGroup=true
spring.fep.server.netty.atm.dynamicEventExecutorIdleCheckInterval=5000

#FISC
spring.fep.server.netty.fisc.host=${spring.fep.hostip}
spring.fep.server.netty.fisc.port=8733
spring.fep.server.netty.fisc.reestablishConnectionInterval=5000
spring.fep.server.netty.fisc.acceptIp=
spring.fep.server.encoding.fisc=ebcdic
spring.fep.server.netty.fisc.serverBisThreadNum=100
spring.fep.server.netty.fisc.useDynamicEventExecutorGroup=true

#ATMMon
spring.fep.server.netty.atmmon.host=${spring.fep.hostip}
spring.fep.server.netty.atmmon.port=28087
spring.fep.server.netty.atmmon.reestablishConnectionInterval=5000
spring.fep.server.netty.atmmon.acceptIp=

#PKI
spring.fep.pki.path=/PKI
spring.fep.pki.file-acdu=acdu
spring.fep.pki.file-acdp=acdp
spring.fep.pki.db-instance-name1=fapinst1
spring.fep.pki.db-instance-name1-db=FEPDB,DESDB
spring.fep.pki.db-instance-name2=fbpinst1
spring.fep.pki.db-instance-name2-db=EMSDB,DESLOGDB,FEPHIS

#Monitor Service Name to Alias Map
spring.fep.monitor.serviceNameToAliasMap.suipsrv=suipsrvA
spring.fep.monitor.serviceNameToAliasMap.suipsrv1=suipsrvB



#3-1

#FISC Adapter
spring.fep.fisc-adapter.primary[0].clientId=B006A03O
spring.fep.fisc-adapter.primary[0].host=172.29.14.2
spring.fep.fisc-adapter.primary[0].port=8734
spring.fep.fisc-adapter.primary[0].alternativeHost=172.29.14.1
spring.fep.fisc-adapter.primary[1].clientId=B006A04O
spring.fep.fisc-adapter.primary[1].host=172.29.14.2
spring.fep.fisc-adapter.primary[1].port=8736
spring.fep.fisc-adapter.primary[1].alternativeHost=172.29.14.1
spring.fep.fisc-adapter.secondary[0].clientId=B006A02O
spring.fep.fisc-adapter.secondary[0].host=172.29.14.1
spring.fep.fisc-adapter.secondary[0].port=8732
spring.fep.fisc-adapter.delay=5
spring.fep.fisc-adapter.alternativeQueueReceiveTimeout=5000
spring.fep.fisc-adapter.protocol=socket